     public bool HasMatchAt(int x, int y)
   {
     int type = candyType[x, y];

     if (type < 0)
        return false;

     int count = 1;

     int i = x - 1;
     while (i >= 0 && candyType[i, y] == type)
     {
        count++;
        i--;
     }

     i = x + 1;
     while (i < width && candyType[i, y] == type)
     {
         count++;
         i++;
     }

     if (count >= 3)
        return true;

     count = 1;

     i = y - 1;
     while (i >= 0 && candyType[x, i] == type)
     {
        count++;
        i--;
     }

     i = y + 1;
     while (i < height && candyType[x, i] == type)
       {
         count++;
         i++;
        }
 
     return count >= 3;
   }
   public bool WouldMakeMatch(int x1, int y1, int x2, int y2)
   {
     int a = candyType[x1, y1];
     int b = candyType[x2, y2];

     candyType[x1, y1] = b;
     candyType[x2, y2] = a;

     bool result =
        HasMatchAt(x1, y1) ||
        HasMatchAt(x2, y2);

     candyType[x1, y1] = a;
     candyType[x2, y2] = b;

     return result;
    }
    IEnumerator UnlockInput()
   {
     yield return new WaitForSeconds(0.5f);

     while (Input.GetMouseButton(0))
     {
         yield return null;
      }

     inputLocked = false;
    }
