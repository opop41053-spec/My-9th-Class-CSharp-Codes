    List<Vector2Int> GetMatches()
    {
        List<Vector2Int> matches =
            new List<Vector2Int>();

        for (int x = 0; x < width; x++)
        {
            for (int y = 0; y < height; y++)
            {
                int type = candyType[x, y];

                if (type < 0)
                    continue;

                if (x < width - 2)
                {
                    if (
                        candyType[x + 1, y] == type &&
                        candyType[x + 2, y] == type
                    )
                    {
                        matches.Add(new Vector2Int(x, y));
                        matches.Add(new Vector2Int(x + 1, y));
                        matches.Add(new Vector2Int(x + 2, y));
                    }
                }
                                     if (
                                      x < width - 3 &&
                                           candyType[x + 1, y] == type &&
                                       candyType[x + 2, y] == type &&
                                       candyType[x + 3, y] == type
                                 )
                               { 
                                     bombPosition = new Vector2Int(x + 1, y);
                                
                                }
                                if (
                                      y < height - 3 &&
                                      candyType[x, y + 1] == type &&
                                      candyType[x, y + 2] == type &&
                                      candyType[x, y + 3] == type
                                   )
                            {
                                    bombPosition = new Vector2Int(x, y + 1);
                                    
                             }
                            
                            

                if (y < height - 2)
                {
                    if (
                        candyType[x, y + 1] == type &&
                        candyType[x, y + 2] == type
                    )
                    {
                        matches.Add(new Vector2Int(x, y));
                        matches.Add(new Vector2Int(x, y + 1));
                        matches.Add(new Vector2Int(x, y + 2));
                    }
                }
            }
        }

        return matches;
    }

    void DestroyCandy(int x, int y)
    {  

        int type = candyType[x, y];

       if (type == bombType)
       {
            if(grid[x,y] != null)
            Destroy(grid[x,y]);

             grid[x, y] = null;
             candyType[x, y] = -1;
             return;
        }

       if (type == 0) redCollected++;
       if (type == 1) blueCollected++;
       if (type == 2) greenCollected++;
       if (type == 3) yellowCollected++;
       if (type == 4) purpleCollected++;
       if (type == 5) orangeCollected++;
    
      
        if (grid[x, y] == null)
            return;

        // POP SOUND
        if (audioSource != null &&
            popSound != null)
        {
            audioSource.PlayOneShot(popSound);
        }

        StartCoroutine(Pop(grid[x, y]));

        grid[x, y] = null;
        candyType[x, y] = -1;
    }

    IEnumerator Fall()
    {
        // FALL SOUND
        if (audioSource != null &&
            fallSound != null)
        {
            audioSource.PlayOneShot(fallSound);
        }

        for (int x = 0; x < width; x++)
        {
            for (int y = 1; y < height; y++)
            {
                if (
                    grid[x, y] != null &&
                    grid[x, y - 1] == null
                )
                {
                    int ny = y;

                    while (
                        ny > 0 &&
                        grid[x, ny - 1] == null
                    )
                    {
                        ny--;
                    }

                    grid[x, ny] = grid[x, y];

                    candyType[x, ny] =
                        candyType[x, y];

                    grid[x, y] = null;
                    candyType[x, y] = -1;

                    StartCoroutine(
                        Move(
                            grid[x, ny],
                            GetPos(x, ny)
                        )
                    );
                }
            }
        }

        yield return new WaitForSeconds(0.15f);

        for (int x = 0; x < width; x++)
        {
            for (
                int y = height - 1;
                y >= 0 &&
                grid[x, y] == null;
                y--
            )
            {
                Spawn(x, y);
            }
        }

        yield return new WaitForSeconds(0.15f);
    }

    IEnumerator Move(
        GameObject obj,
        Vector2 target
    )
    {
        if (obj == null)
            yield break;

        while (
            obj != null &&
            Vector2.Distance(
                obj.transform.position,
                target
            ) > 0.01f
        )
        {
            obj.transform.position =
                Vector2.Lerp(
                    obj.transform.position,
                    target,
                    moveSpeed *
                    Time.deltaTime
                );

            yield return null;
        }

        // ===== FIX ERROR =====
        if (obj != null)
        {
            obj.transform.position = target;
        }
        // =====================
    }

    IEnumerator Pop(GameObject obj)
    {
        if (obj == null)
            yield break;

        Vector3 start =
            obj.transform.localScale;

        float t = 0;

        while (t < 1)
        {
            // ===== FIX ERROR =====
            if (obj == null)
                yield break;
            // =====================

            t +=
                Time.deltaTime *
                popSpeed;

            obj.transform.localScale =
                Vector3.Lerp(
                    start,
                    Vector3.zero,
                    t
                );

            yield return null;
        }

        // ===== FIX ERROR =====
        if (obj != null)
        {
            Destroy(obj);
        }
        // =====================
    }

    bool Inside(int x, int y)
    {
        return
            x >= 0 &&
            x < width &&
            y >= 0 &&
            y < height;
    }

    Vector2 GetSnapPos(Vector2 world)
    {
        int x = GetX(world);
        int y = GetY(world);

        return GetPos(x, y);
    }

    int GetX(Vector2 pos)
    {
        return Mathf.RoundToInt(
            (pos.x - startPos.x) /
            cellSize
        );
    }

    int GetY(Vector2 pos)
    {
        return Mathf.RoundToInt(
            (pos.y - startPos.y) /
            cellSize
        );
    }

    Vector2 GetPos(int x, int y)
    {
        return new Vector2(
            startPos.x + x * cellSize,
            startPos.y + y * cellSize
        );
    }

   IEnumerator BombFall()
   {
      if (bombRunning)
         yield break;

      bombRunning = true;

      yield return new WaitForSeconds(0.1f);

      yield return Fall();

      yield return new WaitForSeconds(0.1f);

      yield return ProcessBoard();

      bombRunning = false;
    }

