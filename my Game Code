    void Update()
    {
       if (busy || inputLocked)
       return;

        Vector2 worldPos =
            Camera.main.ScreenToWorldPoint(
                Input.mousePosition
            );

        if (Input.GetMouseButtonDown(0))
        {
            touchStart = worldPos;

            int x = GetX(worldPos);
            int y = GetY(worldPos);

            if (Inside(x, y))
            {
                selected = grid[x, y];
                dragging = true;
            }
        }

        if (Input.GetMouseButton(0) &&
            dragging &&
            selected != null)
        {
            // ===== FIX ERROR =====
            if (selected == null)
            {
                dragging = false;
                return;
            }
            // =====================

            Vector2 diff =
                worldPos - touchStart;

            Vector2 limited =
                Vector2.zero;

            if (Mathf.Abs(diff.x) >
                Mathf.Abs(diff.y))
            {
                limited.x =
                    Mathf.Clamp(
                        diff.x,
                        -cellSize * 0.55f,
                        cellSize * 0.55f
                    );
            }
            else
            {
                limited.y =
                    Mathf.Clamp(
                        diff.y,
                        -cellSize * 0.55f,
                        cellSize * 0.55f
                    );
            }

            selected.transform.position =
                Vector2.Lerp(
                    selected.transform.position,
                    GetSnapPos(touchStart) + limited,
                    25f * Time.deltaTime
                );
        }

        if (Input.GetMouseButtonUp(0) &&
            dragging)
        {
            dragging = false;

            // ===== FIX ERROR =====
            if (selected == null)
            {
                return;
            }
            // =====================

            Vector2 end = worldPos;
            Vector2 diff =
                end - touchStart;

            int x = GetX(touchStart);
            int y = GetY(touchStart);

            int dx =
                Mathf.Abs(diff.x) >
                Mathf.Abs(diff.y)
                ? (diff.x > 0 ? 1 : -1)
                : 0;

            int dy =
                dx == 0
                ? (diff.y > 0 ? 1 : -1)
                : 0;

            int x2 = x + dx;
            int y2 = y + dy;

            if (Inside(x, y) &&
                Inside(x2, y2))
            {
                StartCoroutine(
                    Swap(x, y, x2, y2)
                );
            }
            else
            {
                StartCoroutine(
                    Move(
                        selected,
                        GetPos(x, y)
                    )
                );
            }

            selected = null;
        }
    }

    void SetupCamera()
    {
        Camera.main.orthographic = true;

        float targetAspect = 9f / 16f;

        float windowAspect =
            (float)Screen.width /
            Screen.height;

        float scaleHeight =
            windowAspect / targetAspect;

        Camera.main.orthographicSize = 6f;

        if (scaleHeight < 1f)
        {
            Camera.main.orthographicSize /=
                scaleHeight;
        }

        Camera.main.transform.position =
            new Vector3(0, 0, -10);
    }

    void SetupBoard()
    {
        float usableHeight =
      Camera.main.orthographicSize * 2f
      - topSpace
      - bottomSpace;

      float usableWidth =
      Camera.main.orthographicSize * 2f *
      Screen.width / Screen.height;

       float cellByHeight =
       usableHeight / height;

      float cellByWidth =
       usableWidth / width;

        cellSize =
      Mathf.Min(cellByHeight, cellByWidth) * 0.78f;

        float boardWidth =
            width * cellSize;

        float boardHeight =
            height * cellSize;

        float startX =
            -boardWidth / 2f
            + cellSize / 2f;

        float startY =
            -boardHeight / 2f
            + cellSize / 2f;
            

        startPos =
            new Vector2(startX, startY);
    }

    void CreateGrid()
    {   

        for (int x = 0; x < width; x++)
        {
            for (int y = 0; y < height; y++)
            {
                Spawn(x, y);
            }
        }
    }

    void Spawn(int x, int y)
    {
        int i =
            Random.Range(
                0,
                candies.Length
            );

        Vector2 spawnPos =
            GetPos(x, y + 3);

        GameObject c =
            Instantiate(
                candies[i],
                spawnPos,
                Quaternion.identity
            );
          

      if (candyHolder != null)
       {
         c.transform.SetParent(
         candyHolder,
         false
         );
        }

      
      float size =
         autoSize
         ? cellSize * 0.72f
        : manualSize;

        if (boardLayout != null)
       {
          size *= boardLayout.boardScale;
        }

        c.transform.localScale = Vector3.one * size;

        grid[x, y] = c;
        candyType[x, y] = i;

        StartCoroutine(
            Move(
                c,
                GetPos(x, y)
            )
        );
    }

    IEnumerator Swap(
        int x1,
        int y1,
        int x2,
        int y2
    )
    {
        busy = true;

        if(moves > 0)
   {
        moves--;
    }

    UpdateScore();

        // SWAP SOUND
        if (audioSource != null &&
            swapSound != null)
        {
            audioSource.PlayOneShot(swapSound);
        }

        GameObject a =
            grid[x1, y1];

        GameObject b =
            grid[x2, y2];

        if (a == null || b == null)
        {
          
            busy = false;
            yield break;
        }

        yield return Move(a, GetPos(x2, y2));
        yield return Move(b, GetPos(x1, y1));

        grid[x1, y1] = b;
        grid[x2, y2] = a;

        int t = candyType[x1, y1];

        candyType[x1, y1] =
            candyType[x2, y2];

        candyType[x2, y2] = t;

        if (HasMatch())
        {
            // WIN SOUND
            if (audioSource != null &&
                winSound != null)
            {
                audioSource.PlayOneShot(winSound);
            }

            yield return ProcessBoard();
       if(moves <= 0)
       {
         if   (
           redCollected >= levelManager.redTarget &&
           blueCollected >= levelManager.blueTarget &&
           greenCollected >= levelManager.greenTarget &&
           yellowCollected >= levelManager.yellowTarget &&
           purpleCollected >= levelManager.purpleTarget &&
           orangeCollected >= levelManager.orangeTarget
          )
         {
           levelManager.LevelComplete();
          }
          else
           {
              Debug.Log("GAME OVER");
            }
          }
        }
        else
        {
            yield return Move(a, GetPos(x1, y1));
            yield return Move(b, GetPos(x2, y2));

            grid[x1, y1] = a;
            grid[x2, y2] = b;

            t = candyType[x1, y1];

            candyType[x1, y1] =
                candyType[x2, y2];

            candyType[x2, y2] = t;
        }

        busy = false;
    }

    bool HasMatch()
    {
        for (int x = 0; x < width; x++)
        {
            for (int y = 0; y < height; y++)
            {
                int type = candyType[x, y];

                if (type < 0)
                    continue;

                if (x < width - 2)
                {
                    if (
                        candyType[x + 1, y] == type &&
                        candyType[x + 2, y] == type
                    )
                    {
                        return true;
                    }
                }

                if (y < height - 2)
                {
                    if (
                        candyType[x, y + 1] == type &&
                        candyType[x, y + 2] == type
                    )
                    {
                        return true;
                    }
                }
            }
        }

        return false;
    }

   IEnumerator ProcessBoard()
{
       if (processingBoard)
        yield break;

    processingBoard = true;

    yield return new WaitForSeconds(0.1f);

    while (true)
    {
        List<Vector2Int> matches = GetMatches();

        if (matches.Count == 0)
            break;
            
            if (PlayerPrefs.GetInt("Vibration", 1) == 1)
           {
               Handheld.Vibrate();
            }

        score += matches.Count * 10;

        UpdateScore();

        foreach (var pos in matches)
        {
            DestroyCandy(pos.x, pos.y);
            
        }

        if (bombPosition.x >= 0 && bombPosition.y >= 0)
       {
              if (grid[bombPosition.x, bombPosition.y] != null)
               {
                  Destroy(grid[bombPosition.x, bombPosition.y]);

                   grid[bombPosition.x, bombPosition.y] = null;
                   candyType[bombPosition.x, bombPosition.y] = -1;
               }
 
                  GameObject bomb = Instantiate(
                  bombPrefab,
                  GetPos(bombPosition.x, bombPosition.y),
                   Quaternion.identity
               );

                   Bomb bombScript = bomb.GetComponent<Bomb>();

                    if (bombScript != null)
                   { 
                      bombScript.candySystem = this;
                    }
                  
                  grid[bombPosition.x, bombPosition.y] = bomb;
                  candyType[bombPosition.x, bombPosition.y] = bombType;

            

               bombPosition = new Vector2Int(-1, -1);
        }

        yield return new WaitForSeconds(0.15f);

        yield return Fall();

    }

    processingBoard = false;

}   // ← ProcessBoard यहीं खत्म होगा



