  public void ExplodeBombAt(Vector2 pos)
   {
      if (processingBoard)
    return;

      int bx = GetX(pos);
       int by = GetY(pos);
       
        for (int x = bx - 1; x <= bx + 1; x++)
       {
          for (int y = by - 1; y <= by + 1; y++)
           {
             if (Inside(x, y))
             {
                 DestroyCandy(x, y);
             }
            }
        }

        score += 100; // Bomb bonus score
        UpdateScore();

       StartCoroutine(BombFall());
     }

